# ==============================================================================
# KAABIL (काबिल) Environment Configuration Template (.env.example)
# Universal Career, Education, Skill Development & Employment Ecosystem
#
# COPY this file to .env (for local development) or configure inside Vercel Dashboard.
# NEVER commit actual secret keys, passwords, or production credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 15+ / Neon Serverless)
# ------------------------------------------------------------------------------
# For Production on Vercel with Neon (https://neon.tech):
# DATABASE_URL: Pooled connection string (with '-pooler' in hostname) used by the Next.js runtime.
# DIRECT_URL: Direct compute connection string (without pooler) used by Prisma CLI for migrations.
#
# Neon Hosted PostgreSQL Example:
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
#
# Local Development Fallback:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaabil_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kaabil_dev?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Auth.js / JWT Session)
# ------------------------------------------------------------------------------
# Mandatory: Generate a secure 32+ character key using: `openssl rand -base64 32`
AUTH_SECRET="your-secure-random-32-character-auth-secret-here"

# Canonical base URL of the deployed application
# For local dev: http://localhost:3000
# For production on Vercel: https://your-kaabil-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Secret key used for HMAC-SHA256 digital signatures on Digital Skill Passport credentials
CREDENTIAL_SIGNING_SECRET="your-secure-credential-signing-secret-min-32-chars"

# ------------------------------------------------------------------------------
# 3. AI CAPABILITIES (Google Gemini API — Trilingual AI Career Mentor)
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio (Free Tier): https://aistudio.google.com/
# When left blank, KAABIL automatically and transparently operates in
# "Verified Knowledge Base Fallback" mode using curated statutory guidelines.
GEMINI_API_KEY=""

# Supported models: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL="gemini-2.0-flash"
AI_FEATURE_ENABLED="true"

# ------------------------------------------------------------------------------
# 4. APPLICATION ENVIRONMENT & DEMO CONTROLS
# ------------------------------------------------------------------------------
# Set to 'production' for live Vercel deployments; 'development' for local work
NEXT_PUBLIC_APP_ENV="development"

# Set to 'false' in production to disable all demo bypasses and enforce strict authentication
NEXT_PUBLIC_DEMO_MODE="false"

# Public URL used in client-side links, QR codes, and share URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. OPTIONAL: RATE LIMITING & TELEMETRY (Upstash Redis)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ==============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST:
# [ ] Create Neon project at https://neon.tech and retrieve DATABASE_URL and DIRECT_URL
# [ ] Run `npx prisma db push` to initialize tables in hosted PostgreSQL
# [ ] Obtain GEMINI_API_KEY from Google AI Studio
# [ ] Generate 32+ char AUTH_SECRET (`openssl rand -base64 32`)
# [ ] Generate 32+ char CREDENTIAL_SIGNING_SECRET
# [ ] Set NEXT_PUBLIC_DEMO_MODE="false" in production environment
# [ ] Set NEXTAUTH_URL and NEXT_PUBLIC_APP_URL to the production domain
# [ ] Add all variables in Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================
