# ==============================================================================
# KAABIL (काबिल) Environment Configuration Template (.env.example)
# Universal Career, Education, Skill Development & Employment Ecosystem
#
# COPY this file to .env (for local development) or .env.production (for production).
# Never commit actual secret keys or credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 15+ / Neon Serverless)
# ------------------------------------------------------------------------------
# In production on Vercel with Neon (https://neon.tech):
# DATABASE_URL: Pooled connection string (with '-pooler' in host) used by the application
# DIRECT_URL: Direct compute connection string (without pooler) used by Prisma CLI for migrations
#
# Neon Example:
# DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
#
# Local Offline Development Example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaabil_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kaabil_dev?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Auth.js / JWT Session)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key using: `openssl rand -base64 32`
AUTH_SECRET="your-secure-random-32-character-auth-secret-here"

# Canonical URL of the application
# For local dev: http://localhost:3000
# For production on Vercel: https://your-app-name.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Secret key used for HMAC-SHA256 digital signatures on Digital Skill Passport credentials
CREDENTIAL_SIGNING_SECRET="your-secure-credential-signing-secret-min-32-chars"

# ------------------------------------------------------------------------------
# 3. AI CAPABILITIES (Google Gemini API - Trilingual AI Career Mentor)
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio (Free Tier): https://aistudio.google.com/
GEMINI_API_KEY=""

# Supported models: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL="gemini-2.0-flash"
AI_FEATURE_ENABLED="true"

# ------------------------------------------------------------------------------
# 4. APPLICATION ENVIRONMENT & DEMO CONTROLS
# ------------------------------------------------------------------------------
# Set to 'production' for live Vercel deployments; 'development' for local work
NEXT_PUBLIC_APP_ENV="development"

# Set to 'false' in production to disable all demo bypasses and enforce strict DB auth
NEXT_PUBLIC_DEMO_MODE="false"

# Public URL used in client-side links and share URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 5. OPTIONAL: RATE LIMITING & TELEMETRY (Upstash Redis)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
